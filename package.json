{
  "name": "token-saver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": [
    "packages/*"
  ],
  "bin": { "token-saver": "./dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:chmod",
    "build:chmod": "node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -b packages/core packages/replay packages/pi",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": { "@typesafe-ai/sdk": "^0.6.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
